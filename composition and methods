# COMPOSITION: Hostel owns its Rooms
class Room:
    def __init__(self, number):
        self.number = number
        self.occupant = None


class Hostel:
    def __init__(self, name):
        self.name = name
        self.rooms = [Room(n) for n in range(1, 21)]    # the hostel creates its 20 rooms
        self.students = []
        self.items = []
        self.borrowings = []
        self.rules = [NotOwnerRule(), AvailableRule(), MaxDaysRule(), StrikeRule()]
        self.__counter = 0                              # used to make handover codes

    def register(self, student):
        if student.room_no < 1 or student.room_no > 20:
            return "Only residents of rooms 1-20 can register."
        room = self.rooms[student.room_no - 1]
        if room.occupant is not None:
            return "Room already taken."
        room.occupant = student
        self.students.append(student)
        return "Registered " + str(student)

    def add_item(self, item):
        self.items.append(item)

# method overloading with default values: three ways to search
    def search(self, keyword=None, max_fee=None):
        found = []
        for item in self.items:
            if not item.is_available():
                continue
            if keyword is not None and keyword.lower() not in item.name.lower():
                continue
            if max_fee is not None and item.fee_per_day > max_fee:
                continue
            found.append(item)
        return found

    def request(self, student, item, days):
        for rule in self.rules:                         # duck typing in action
            problem = rule.check(student, item, days)
            if problem:
                return None, problem
        self.__counter += 1
        code = 1000 + (self.__counter * 7919) % 9000    # simple 4-digit code
        loan = Borrowing(item, student, days, code)
        self.borrowings.append(loan)
        return loan, "Request sent."
