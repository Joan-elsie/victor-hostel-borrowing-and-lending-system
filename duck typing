# DUCK TYPING: eligibility rules share NO parent class 
# Each rule only needs a check() method. It returns None if OK, or a message.
class NotOwnerRule:
    def check(self, student, item, days):
        if student is item.owner:
            return "You cannot borrow your own item."




class AvailableRule:
    def check(self, student, item, days):
        if not item.is_available():
            return "Item is not available."




class MaxDaysRule:
    def check(self, student, item, days):
        if days < 1 or days > item.max_days:
            return "Allowed period is 1 to " + str(item.max_days) + " days."




class StrikeRule:
    def check(self, student, item, days):
        if student.get_strikes() >= 3:
            return "Too many strikes (3). You cannot borrow."




